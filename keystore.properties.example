# Copy this file to keystore.properties to build a signed release.
# keystore.properties is git-ignored and MUST NOT be committed.
#
# storeFile is relative to the repository root, or may be an absolute path.
# Keep the actual .jks file outside the repository, or in the ignored
# keystore/ directory. The official signing key is not part of this project.
storeFile=keystore/your-release-key.jks
storePassword=change-me
keyAlias=change-me
keyPassword=change-me
